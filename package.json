{
  "name": "payments-grade-wallet-ledger",
  "version": "1.0.0",
  "description": "Double-entry wallet ledger: safe transfers, idempotency, nightly reconciliation, fraud holds, LLM statement Q&A",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "seed": "tsx scripts/seed.ts",
    "naive-stampede": "tsx scripts/naive-stampede.ts",
    "isolation-lab": "bash scripts/isolation-lab.sh",
    "demo": "tsx scripts/demo.ts",
    "bench:explain": "tsx scripts/bench-explain.ts",
    "bench:fraud": "tsx scripts/bench-fraud.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "node-cron": "^4.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
